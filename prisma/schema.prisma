  DRAFT
  ACTIVE
  PARTIALLY_DISPENSED
  DISPENSED
  COMPLETED
  CANCELLED
}

model Prescription {
  id              String             @id @default(uuid(7)) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  branchId        String             @map("branch_id") @db.Uuid
  encounterId     String?            @map("encounter_id") @db.Uuid
  encounter       Encounter?         @relation(fields: [encounterId], references: [id])
  petId           String             @map("pet_id") @db.Uuid
  pet             Pet                @relation(fields: [petId], references: [id])
  productId       String             @map("product_id") @db.Uuid
  product         Product            @relation(fields: [productId], references: [id])
  /// ขนาดต่อครั้งในหน่วยฐานของสินค้า (เม็ด / ml)
  doseAmount      Decimal            @map("dose_amount") @db.Decimal(12, 4)
  doseUnit        String             @map("dose_unit")
  /// น้ำหนักที่ใช้คำนวณ ณ เวลาสั่ง — ต้องเก็บ ไม่ใช้น้ำหนักล่าสุด
  weightKgAtOrder Decimal?           @map("weight_kg_at_order") @db.Decimal(8, 3)
  mgPerKg         Decimal?           @map("mg_per_kg") @db.Decimal(10, 4)
  route           String // PO, SC, IV, IM, TOPICAL, OTIC, OPHTH
  frequencyCode   String             @map("frequency_code") // SID, BID, TID, QID, q8h, PRN
  timesPerDay     Decimal            @map("times_per_day") @db.Decimal(5, 2)
  durationDays    Int                @map("duration_days")
  totalQtyBase    Decimal            @map("total_qty_base") @db.Decimal(12, 4)
