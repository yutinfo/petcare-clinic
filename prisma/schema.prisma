enum ServiceCategory {
  CONSULT
  PROCEDURE
  SURGERY
  LAB
  IMAGING
  VACCINE
  GROOMING
  BOARDING
  NURSING
  OTHER
}

enum TaxCode {
  VAT7 // ภาษีมูลค่าเพิ่ม 7%
  VAT0 // อัตราศูนย์
  EXEMPT // ยกเว้นภาษี
  NONVAT // กิจการไม่จด VAT
}

model ServiceItem {
  id                   String          @id @default(uuid(7)) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  code                 String
  name                 String
  category             ServiceCategory
