// ============================================================================
// PetCare Cloud — ระบบบริหารจัดการคลินิกสัตว์เลี้ยง
// สคีมาฉบับร่าง — ดูคำอธิบายเหตุผลที่ docs/02-data-model.md
//
// กติกาที่ใช้ตลอดไฟล์นี้
//  1. tenantId / branchId / *ById (ผู้ใช้งาน) เก็บเป็น scalar ล้วน ไม่ประกาศ relation
//     เพื่อไม่ให้ Tenant/Branch/Membership มี back-relation หลายสิบตัวจนอ่านไม่ออก
//     >> FOREIGN KEY และ RLS POLICY ของฟิลด์เหล่านี้สร้างใน migration SQL แยก
//     (prisma/migrations/manual/001_rls_and_constraints.sql)
//  2. เงินเป็น Int หน่วย "สตางค์" ชื่อฟิลด์ลงท้าย Satang เสมอ
//  3. ปริมาณสต็อก/ขนาดยาเป็น Decimal(14,4) หน่วยฐานของสินค้านั้น
//  4. เวลาเป็น timestamptz (UTC) — แปลงเป็น Asia/Bangkok ที่ชั้นแสดงผล
//  5. ชื่อตาราง = PascalCase, ชื่อคอลัมน์ = snake_case ผ่าน @map, ฟิลด์ TS = camelCase
//     ฟิลด์ใหม่ทุกตัวต้องใส่ @map("snake_case") มิฉะนั้น RLS policy และ trigger
//     ที่อ้างชื่อ snake_case จะพังเงียบ ๆ
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("MIGRATE_DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, btree_gist]
}

// ============================================================================
// PLATFORM / IDENTITY
// ============================================================================

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

model Tenant {
  id          String       @id @default(uuid(7)) @db.Uuid
  slug        String       @unique // ใช้เป็น subdomain: clinicA.petcare.app
  legalName   String       @map("legal_name") // ชื่อนิติบุคคลตามหนังสือรับรอง
  displayName String       @map("display_name")
  taxId       String?      @map("tax_id") // เลขประจำตัวผู้เสียภาษี 13 หลัก
  logoKey     String?      @map("logo_key")
  status      TenantStatus @default(TRIAL)
  locale      String       @default("th")
  timezone    String       @default("Asia/Bangkok")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  branches     Branch[]
  memberships  Membership[]
  subscription Subscription?
}

model Branch {
  id            String  @id @default(uuid(7)) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  code          String // ใช้ในเลขที่เอกสาร เช่น BKK
  name          String
  addressLine   String? @map("address_line")
  subDistrict   String? @map("sub_district")
  district      String?
  province      String?
  postalCode    String? @map("postal_code")
  phone         String?
  isHeadOffice  Boolean @default(false) @map("is_head_office")
  taxBranchCode String  @default("00000") @map("tax_branch_code") // "00000" = สำนักงานใหญ่
  openTimeJson  Json?   @map("open_time_json") // เวลาทำการรายวัน
  isActive      Boolean @default(true) @map("is_active")

  taxProfile TaxProfile?

  @@unique([tenantId, code])
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// บัญชีผู้ใช้ระดับแพลตฟอร์ม — คนเดียวเป็นพนักงานได้หลายคลินิก
model User {
  id             String     @id @default(uuid(7)) @db.Uuid
  email          String?    @unique
  phone          String?    @unique // เจ้าของสัตว์ล็อกอินด้วย OTP เบอร์โทร
  passwordHash   String?    @map("password_hash")
  displayName    String     @map("display_name")
  avatarKey      String?    @map("avatar_key")
  status         UserStatus @default(INVITED)
  mfaSecret      String?    @map("mfa_secret") // TOTP (เข้ารหัสที่ชั้นแอป)
  mfaEnabledAt   DateTime?  @map("mfa_enabled_at") @db.Timestamptz
  lastLoginAt    DateTime?  @map("last_login_at") @db.Timestamptz
  isPlatformRoot Boolean    @default(false) @map("is_platform_root")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz

  memberships  Membership[]
  ownerProfile Owner?
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

/// การเป็นพนักงานของคลินิกหนึ่ง — เป็น "ตัวตนผู้ปฏิบัติงาน" ที่โมดูลอื่นอ้างถึง
model Membership {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userId          String           @map("user_id") @db.Uuid
  user            User             @relation(fields: [userId], references: [id])
  roleId          String           @map("role_id") @db.Uuid
  role            Role             @relation(fields: [roleId], references: [id])
  status          MembershipStatus @default(INVITED)
  employeeCode    String?          @map("employee_code")
  jobTitle        String?          @map("job_title")
  licenseNo       String?          @map("license_no") // เลขใบอนุญาตประกอบวิชาชีพการสัตวแพทย์
  signatureKey    String?          @map("signature_key") // ลายเซ็นดิจิทัลสำหรับใบรับรอง
  defaultBranchId String?          @map("default_branch_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz

  branches MembershipBranch[]

  @@unique([tenantId, userId])
  @@index([tenantId, status])
}

model MembershipBranch {
  membershipId String     @map("membership_id") @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branchId     String     @map("branch_id") @db.Uuid

  @@id([membershipId, branchId])
}

model Role {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid // null = บทบาทสำเร็จรูปของระบบ
  key      String // VET, RECEPTIONIST, GROOMER, ...
  name     String
  isSystem Boolean @default(false) @map("is_system")

  permissions RolePermission[]
  memberships Membership[]

  @@unique([tenantId, key])
}

model Permission {
  key         String @id // "clinical:write", "billing:void_invoice"
  group       String
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId        String     @map("role_id") @db.Uuid
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String     @map("permission_key")
  permission    Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
}

/// เขียนอย่างเดียว — trigger ห้าม UPDATE/DELETE
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  branchId      String?  @map("branch_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorMemberId String?  @map("actor_member_id") @db.Uuid
  action        String // "encounter.close", "invoice.void"
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  before        Json?
  after         Json?
  reason        String?
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, occurredAt])
}

/// Transactional outbox — เขียนพร้อมข้อมูลจริงในทรานแซกชันเดียว แล้ว worker ค่อยดึงไปทำ
model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([processedAt, createdAt])
}

// ============================================================================
// SAAS
// ============================================================================

model Plan {
  key         String   @id
  name        String
  priceSatang Int      @map("price_satang")
  maxBranches Int      @map("max_branches")
  maxStaff    Int      @map("max_staff")
  features    String[]
  isActive    Boolean  @default(true) @map("is_active")

  subscriptions Subscription[]
}

model Subscription {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @unique @map("tenant_id") @db.Uuid
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  planKey          String    @map("plan_key")
  plan             Plan      @relation(fields: [planKey], references: [key])
  status           String    @default("TRIALING")
  seats            Int       @default(5)
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz
  trialEndsAt      DateTime? @map("trial_ends_at") @db.Timestamptz
  currentPeriodEnd DateTime? @map("current_period_end") @db.Timestamptz
  cancelAt         DateTime? @map("cancel_at") @db.Timestamptz
}

model FeatureFlag {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid
  key      String
  enabled  Boolean @default(false)
  payload  Json?

  @@unique([tenantId, key])
}

// ============================================================================
// CRM — เจ้าของสัตว์
// ============================================================================

model Owner {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  code              String // O-4K7Q2 — ใช้พูดกับลูกค้า
  prefix            String? // นาย/นาง/นางสาว
  firstName         String    @map("first_name")
  lastName          String?   @map("last_name")
  nickname          String?
  searchKey         String    @map("search_key") // normalize แล้ว ใช้กับ pg_trgm
  email             String?
  lineUserId        String?   @map("line_user_id")
  addressLine       String?   @map("address_line")
  subDistrict       String?   @map("sub_district")
  district          String?
  province          String?
  postalCode        String?   @map("postal_code")
  taxId             String?   @map("tax_id") // สำหรับออกใบกำกับภาษีเต็มรูป
  taxBranchCode     String?   @map("tax_branch_code")
  idCardNoEnc       String?   @map("id_card_no_enc") // เข้ารหัสที่ชั้นแอป เก็บเฉพาะเมื่อจำเป็น
  note              String?
  isBlocked         Boolean   @default(false) @map("is_blocked")
  blockReason       String?   @map("block_reason")
  creditLimitSatang Int       @default(0) @map("credit_limit_satang")
  referralSource    String?   @map("referral_source")
  userId            String?   @unique @map("user_id") @db.Uuid // บัญชีพอร์ทัล (ถ้าเปิดใช้)
  user              User?     @relation(fields: [userId], references: [id])
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  phones       OwnerPhone[]
  consents     OwnerConsent[]
  pets         Pet[]
  bookings     Booking[]
  encounters   Encounter[]
  stays        Stay[]
  groomingJobs GroomingJob[]
  chargeItems  ChargeItem[]
  invoices     Invoice[]
  deposits     Deposit[]
  posSales     PosSale[]

  @@unique([tenantId, code])
  @@index([tenantId, lastName, firstName])
}

model OwnerPhone {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  ownerId   String  @map("owner_id") @db.Uuid
  owner     Owner   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  label     String  @default("มือถือ")
  raw       String
  digits    String // ตัวเลขล้วน ใช้ค้นด้วย 4 ตัวท้าย
  isPrimary Boolean @default(false) @map("is_primary")

  @@index([tenantId, digits])
}

enum ConsentType {
  PDPA_GENERAL
  MARKETING
  PHOTO_SHARING
  MEDICAL_DISCLOSURE
}

model OwnerConsent {
  id          String      @id @default(uuid(7)) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  ownerId     String      @map("owner_id") @db.Uuid
  owner       Owner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type        ConsentType
  version     String // เวอร์ชันของข้อความคำยินยอมที่ลูกค้าเห็น
  grantedAt   DateTime?   @map("granted_at") @db.Timestamptz
  revokedAt   DateTime?   @map("revoked_at") @db.Timestamptz
  channel     String // WEB, PAPER, IN_APP
  evidenceKey String?     @map("evidence_key") // ไฟล์สแกน/ลายเซ็น

  @@index([tenantId, ownerId, type])
}

// ============================================================================
// PATIENT — สัตว์เลี้ยง
// ============================================================================

model Species {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid // null = ข้อมูลกลางของระบบ
  code     String
  nameTh   String  @map("name_th")
  nameEn   String  @map("name_en")
  isActive Boolean @default(true) @map("is_active")

  breeds Breed[]
  pets   Pet[]

  @@unique([tenantId, code])
}

model Breed {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String? @map("tenant_id") @db.Uuid
  speciesId String  @map("species_id") @db.Uuid
  species   Species @relation(fields: [speciesId], references: [id])
  nameTh    String  @map("name_th")
  nameEn    String? @map("name_en")
  isActive  Boolean @default(true) @map("is_active")

  pets Pet[]

  @@index([speciesId, nameTh])
}

enum PetSex {
  MALE
  FEMALE
  UNKNOWN
}

enum PetStatus {
  ACTIVE
  DECEASED
  TRANSFERRED_OUT
  LOST
}

model Pet {
  id                  String    @id @default(uuid(7)) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  code                String // P-8F3K2
  ownerId             String    @map("owner_id") @db.Uuid
  owner               Owner     @relation(fields: [ownerId], references: [id])
  name                String
  searchKey           String    @map("search_key")
  speciesId           String    @map("species_id") @db.Uuid
  species             Species   @relation(fields: [speciesId], references: [id])
  breedId             String?   @map("breed_id") @db.Uuid
  breed               Breed?    @relation(fields: [breedId], references: [id])
  sex                 PetSex    @default(UNKNOWN)
  isNeutered          Boolean   @default(false) @map("is_neutered")
  neuteredAt          DateTime? @map("neutered_at") @db.Date
  birthDate           DateTime? @map("birth_date") @db.Date
  birthDateIsEstimate Boolean   @default(false) @map("birth_date_is_estimate")
  colorMarkings       String?   @map("color_markings")
  microchipNo         String?   @map("microchip_no")
  microchipAt         DateTime? @map("microchip_at") @db.Date
  bloodType           String?   @map("blood_type")
  photoKey            String?   @map("photo_key")
  insuranceProvider   String?   @map("insurance_provider")
  insurancePolicyNo   String?   @map("insurance_policy_no")
  /// cache สำหรับแสดงผล — ข้อมูลจริงอยู่ที่ PetWeight
  currentWeightKg     Decimal?  @map("current_weight_kg") @db.Decimal(8, 3)
  currentWeightAt     DateTime? @map("current_weight_at") @db.Timestamptz
  status              PetStatus @default(ACTIVE)
  deceasedAt          DateTime? @map("deceased_at") @db.Date
  deceasedCause       String?   @map("deceased_cause")
  note                String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz

  weights            PetWeight[]
  alerts             PetAlert[]
  vaccinations       Vaccination[]
  ownerHistory       PetOwnerHistory[]
  bookings           Booking[]
  encounters         Encounter[]
  stays              Stay[]
  groomingJobs       GroomingJob[]
  groomingPreference GroomingPreference?
  problems           Problem[]
  prescriptions      Prescription[]
  chargeItems        ChargeItem[]
  consentForms       ConsentForm[]

  @@unique([tenantId, code])
  @@index([tenantId, ownerId])
  @@index([tenantId, microchipNo])
}

model PetWeight {
  id                 String     @id @default(uuid(7)) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  petId              String     @map("pet_id") @db.Uuid
  pet                Pet        @relation(fields: [petId], references: [id], onDelete: Cascade)
  encounterId        String?    @map("encounter_id") @db.Uuid
  encounter          Encounter? @relation(fields: [encounterId], references: [id])
  measuredAt         DateTime   @map("measured_at") @db.Timestamptz
  weightKg           Decimal    @map("weight_kg") @db.Decimal(8, 3)
  bodyConditionScore Int?       @map("body_condition_score") // 1-9
  source             String     @default("CLINIC_SCALE")
  recordedById       String?    @map("recorded_by_id") @db.Uuid

  @@index([petId, measuredAt])
}

enum PetAlertType {
  ALLERGY
  CHRONIC_CONDITION
  BEHAVIOUR // ดุ กัด ต้องใส่ตะกร้อ
  DRUG_REACTION
  DIET
  OTHER
}

/// แสดงเป็นแถบเตือนสีแดงบนหัวจอทุกหน้าที่เกี่ยวกับสัตว์ตัวนี้
model PetAlert {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  petId       String       @map("pet_id") @db.Uuid
  pet         Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)
  type        PetAlertType
  severity    String       @default("MEDIUM") // LOW | MEDIUM | HIGH
  label       String
  detail      String?
  activeFrom  DateTime     @default(now()) @map("active_from") @db.Timestamptz
  activeTo    DateTime?    @map("active_to") @db.Timestamptz
  createdById String?      @map("created_by_id") @db.Uuid

  @@index([petId, activeTo])
}

model PetOwnerHistory {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  petId         String   @map("pet_id") @db.Uuid
  pet           Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  fromOwnerId   String?  @map("from_owner_id") @db.Uuid
  toOwnerId     String   @map("to_owner_id") @db.Uuid
  transferredAt DateTime @default(now()) @map("transferred_at") @db.Timestamptz
  reason        String?
  recordedById  String?  @map("recorded_by_id") @db.Uuid
}

model Vaccination {
  id               String     @id @default(uuid(7)) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  branchId         String     @map("branch_id") @db.Uuid
  petId            String     @map("pet_id") @db.Uuid
  pet              Pet        @relation(fields: [petId], references: [id], onDelete: Cascade)
  encounterId      String?    @map("encounter_id") @db.Uuid
  encounter        Encounter? @relation(fields: [encounterId], references: [id])
  productId        String?    @map("product_id") @db.Uuid
  product          Product?   @relation(fields: [productId], references: [id])
  vaccineName      String     @map("vaccine_name")
  vaccineType      String?    @map("vaccine_type") // RABIES, DHPPL, FVRCP, ...
  lotNo            String?    @map("lot_no")
  expiryDate       DateTime?  @map("expiry_date") @db.Date
  administeredAt   DateTime   @map("administered_at") @db.Timestamptz
  administeredById String?    @map("administered_by_id") @db.Uuid
  injectionSite    String?    @map("injection_site")
  nextDueAt        DateTime?  @map("next_due_at") @db.Date
  certificateNo    String?    @map("certificate_no") // เลขที่ใบรับรองการฉีดวัคซีน
  certificateKey   String?    @map("certificate_key")
  note             String?

  @@index([tenantId, petId, administeredAt])
  @@index([tenantId, nextDueAt])
}

// ============================================================================
// SCHEDULING — ทรัพยากรและการจอง
// ============================================================================

enum ResourceType {
  VET
  VET_TECH
  GROOMER
  EXAM_ROOM
  GROOMING_STATION
  KENNEL // กรง/ห้องฝาก/ห้องผู้ป่วยใน
  EQUIPMENT // เครื่องอัลตราซาวด์ ห้องผ่าตัด
}

/// ทุกอย่างที่ "จองเวลาได้" ใช้ตารางนี้ร่วมกัน
model Resource {
  id           String       @id @default(uuid(7)) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  branchId     String       @map("branch_id") @db.Uuid
  type         ResourceType
  code         String
  name         String
  membershipId String?      @map("membership_id") @db.Uuid // ถ้าทรัพยากรนี้คือคน
  capacity     Int          @default(1)
  colorHex     String?      @map("color_hex")
  sortOrder    Int          @default(0) @map("sort_order")
  isActive     Boolean      @default(true) @map("is_active")

  kennelProfile    KennelProfile?
  shifts           ResourceShift[]
  timeOffs         ResourceTimeOff[]
