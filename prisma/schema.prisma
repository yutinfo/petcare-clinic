  instructionTh   String             @map("instruction_th") // ข้อความบนฉลากยา
  warningTh       String?            @map("warning_th")
  withFood        Boolean?           @map("with_food")
  status          PrescriptionStatus @default(ACTIVE)
  prescriberId    String             @map("prescriber_id") @db.Uuid
  prescribedAt    DateTime           @default(now()) @map("prescribed_at") @db.Timestamptz
  cancelReason    String?            @map("cancel_reason")

  dispenses       Dispense[]
  administrations MedAdmin[]

  @@index([tenantId, petId, prescribedAt])
  @@index([tenantId, status])
}

