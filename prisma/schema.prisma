  code         String
  name         String
  taxId        String? @map("tax_id")
  contactName  String? @map("contact_name")
  phone        String?
  email        String?
  address      String?
  paymentTerms String? @map("payment_terms") // "เครดิต 30 วัน"
  isActive     Boolean @default(true) @map("is_active")

  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(uuid(7)) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  branchId       String              @map("branch_id") @db.Uuid
  number         String
  supplierId     String              @map("supplier_id") @db.Uuid
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  orderedAt      DateTime?           @map("ordered_at") @db.Timestamptz
  expectedAt     DateTime?           @map("expected_at") @db.Date
  subtotalSatang Int                 @default(0) @map("subtotal_satang")
  vatSatang      Int                 @default(0) @map("vat_satang")
  totalSatang    Int                 @default(0) @map("total_satang")
  note           String?
  createdById    String              @map("created_by_id") @db.Uuid
  approvedById   String?             @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?           @map("approved_at") @db.Timestamptz

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([tenantId, number])
  @@index([tenantId, branchId, status])
}

model PurchaseOrderLine {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String        @map("product_id") @db.Uuid
  product         Product       @relation(fields: [productId], references: [id])
  unitName        String        @map("unit_name")
  factorToBase    Decimal       @map("factor_to_base") @db.Decimal(14, 4)
  qtyOrdered      Decimal       @map("qty_ordered") @db.Decimal(14, 4)
  qtyReceivedBase Decimal       @default(0) @map("qty_received_base") @db.Decimal(14, 4)
  unitCostSatang  Int           @map("unit_cost_satang")
  note            String?
}

model GoodsReceipt {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  branchId          String         @map("branch_id") @db.Uuid
  number            String
  purchaseOrderId   String?        @map("purchase_order_id") @db.Uuid
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplierId        String         @map("supplier_id") @db.Uuid
  supplierInvoiceNo String?        @map("supplier_invoice_no")
  receivedAt        DateTime       @default(now()) @map("received_at") @db.Timestamptz
  receivedById      String         @map("received_by_id") @db.Uuid
  note              String?

  lines GoodsReceiptLine[]

  @@unique([tenantId, number])
}

model GoodsReceiptLine {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  goodsReceiptId String       @map("goods_receipt_id") @db.Uuid
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  productId      String       @map("product_id") @db.Uuid
  product        Product      @relation(fields: [productId], references: [id])
  unitName       String       @map("unit_name")
  qty            Decimal      @db.Decimal(14, 4)
  qtyBase        Decimal      @map("qty_base") @db.Decimal(14, 4)
  lotNo          String       @map("lot_no")
  expiryDate     DateTime?    @map("expiry_date") @db.Date
  unitCostSatang Int          @map("unit_cost_satang")
  lotId          String?      @map("lot_id") @db.Uuid
}

model StockLot {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  product        Product   @relation(fields: [productId], references: [id])
  lotNo          String    @map("lot_no")
  expiryDate     DateTime? @map("expiry_date") @db.Date
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz
  unitCostSatang Int       @map("unit_cost_satang")
  supplierId     String?   @map("supplier_id") @db.Uuid
  isQuarantined  Boolean   @default(false) @map("is_quarantined")

  movements StockMovement[]
  onHand    StockOnHand[]

  @@unique([tenantId, branchId, productId, lotNo])
  @@index([tenantId, branchId, productId, expiryDate])
}

enum StockMovementType {
  RECEIPT // รับเข้าจากการซื้อ
  DISPENSE // จ่ายยาให้สัตว์
  SALE // ขายหน้าร้าน
  RETURN_IN // ลูกค้าคืน
  RETURN_OUT // คืนผู้ขาย
  ADJUST_IN
  ADJUST_OUT
  TRANSFER_IN
  TRANSFER_OUT
  WASTE // หมดอายุ / แตกเสียหาย
  COUNT_ADJUST // ปรับตามผลตรวจนับ
  INTERNAL_USE // ใช้ในคลินิก ไม่คิดเงิน
}

/// บัญชีเดินสะพัดของสต็อก — append-only (trigger ห้าม UPDATE/DELETE)
/// qtyBase เป็นบวกเมื่อเข้า ลบเมื่อออก
model StockMovement {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  product        Product           @relation(fields: [productId], references: [id])
  lotId          String?           @map("lot_id") @db.Uuid
  lot            StockLot?         @relation(fields: [lotId], references: [id])
  type           StockMovementType
  qtyBase        Decimal           @map("qty_base") @db.Decimal(14, 4)
  unitCostSatang Int?              @map("unit_cost_satang")
  refType        String?           @map("ref_type") // PRESCRIPTION, POS_SALE, GOODS_RECEIPT, STOCK_COUNT
  refId          String?           @map("ref_id") @db.Uuid
  dispenseId     String?           @map("dispense_id") @db.Uuid
  dispense       Dispense?         @relation(fields: [dispenseId], references: [id])
  occurredAt     DateTime          @default(now()) @map("occurred_at") @db.Timestamptz
  performedById  String            @map("performed_by_id") @db.Uuid
  reason         String?

  @@index([tenantId, branchId, productId, occurredAt])
  @@index([tenantId, refType, refId])
}

/// cache ยอดคงเหลือ อัปเดตด้วย trigger จาก StockMovement — กันสต็อกติดลบที่ชั้น DB
model StockOnHand {
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id])
  lotId     String   @map("lot_id") @db.Uuid
  lot       StockLot @relation(fields: [lotId], references: [id])
  qtyBase   Decimal  @default(0) @map("qty_base") @db.Decimal(14, 4)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([tenantId, branchId, productId, lotId])
  @@index([tenantId, branchId, productId])
}

model StockTransfer {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  number       String
