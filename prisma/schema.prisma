  branchId        String        @map("branch_id") @db.Uuid
  ownerId         String        @map("owner_id") @db.Uuid
  owner           Owner         @relation(fields: [ownerId], references: [id])
  type            String        @default("BOOKING_DEPOSIT") // BOOKING_DEPOSIT | STORE_CREDIT | REFUND_CREDIT
  amountSatang    Int           @map("amount_satang")
  balanceSatang   Int           @map("balance_satang")
  bookingId       String?       @map("booking_id") @db.Uuid
  sourcePaymentId String?       @map("source_payment_id") @db.Uuid
  status          DepositStatus @default(AVAILABLE)
  expiresAt       DateTime?     @map("expires_at") @db.Date
  note            String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, ownerId, status])
}

model CashierShift {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  branchId           String    @map("branch_id") @db.Uuid
  cashierId          String    @map("cashier_id") @db.Uuid
  openedAt           DateTime  @default(now()) @map("opened_at") @db.Timestamptz
  closedAt           DateTime? @map("closed_at") @db.Timestamptz
  openingFloatSatang Int       @default(0) @map("opening_float_satang")
  expectedCashSatang Int?      @map("expected_cash_satang")
  countedCashSatang  Int?      @map("counted_cash_satang")
  varianceSatang     Int?      @map("variance_satang")
  status             String    @default("OPEN") // OPEN | CLOSED | RECONCILED
  closingNote        String?   @map("closing_note")
  closedById         String?   @map("closed_by_id") @db.Uuid

  payments Payment[]

  @@index([tenantId, branchId, openedAt])
}

/// ตัวนับเลขที่เอกสารแบบไม่มีเลขว่าง — ล็อกแถวด้วย SELECT ... FOR UPDATE
model DocumentSequence {
  tenantId   String   @map("tenant_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  docType    String   @map("doc_type") // INVOICE_FULL, INVOICE_ABB, RECEIPT, CREDIT_NOTE, ENCOUNTER, PO
  period     String // "2569" หรือ "256909" แล้วแต่รูปแบบที่คลินิกเลือก
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([tenantId, branchId, docType, period])
}

/// ข้อมูลภาษีระดับสาขา — คลินิกที่ยังไม่จด VAT จะออกเป็นใบเสร็จรับเงินแทน
model TaxProfile {
  id                    String  @id @default(uuid(7)) @db.Uuid
  tenantId              String  @map("tenant_id") @db.Uuid
  branchId              String  @unique @map("branch_id") @db.Uuid
  branch                Branch  @relation(fields: [branchId], references: [id])
  isVatRegistered       Boolean @default(false) @map("is_vat_registered")
  vatRatePercent        Decimal @default(7) @map("vat_rate_percent") @db.Decimal(5, 2)
  taxId                 String? @map("tax_id")
  taxBranchCode         String  @default("00000") @map("tax_branch_code")
  sellerName            String  @map("seller_name")
  sellerAddress         String  @map("seller_address")
  /// true = ราคาที่ตั้งไว้รวม VAT แล้ว (ต้องถอด VAT ตอนออกบิล)
  pricesIncludeVat      Boolean @default(true) @map("prices_include_vat")
  abbreviatedApprovalNo String? @map("abbreviated_approval_no") // เลขอนุมัติใช้เครื่องบันทึกการเก็บเงิน
  invoicePrefix         String  @default("INV") @map("invoice_prefix")
  receiptFooterTh       String? @map("receipt_footer_th")
  etaxEnabled           Boolean @default(false) @map("etax_enabled")
  etaxProvider          String? @map("etax_provider")
}

// ============================================================================
// NOTIFICATION
// ============================================================================

enum NotificationChannel {
  EMAIL
  SMS
  LINE
  PUSH
  IN_APP
}

model NotificationTemplate {
  id       String              @id @default(uuid(7)) @db.Uuid
  tenantId String?             @map("tenant_id") @db.Uuid
  key      String // APPOINTMENT_REMINDER, VACCINE_DUE, STAY_UPDATE
  channel  NotificationChannel
  locale   String              @default("th")
  subject  String?
  body     String
  isActive Boolean             @default(true) @map("is_active")

  @@unique([tenantId, key, channel, locale])
}

model NotificationLog {
  id          String              @id @default(uuid(7)) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  channel     NotificationChannel
  templateKey String              @map("template_key")
  ownerId     String?             @map("owner_id") @db.Uuid
  toAddress   String              @map("to_address")
  payload     Json?
  status      String              @default("QUEUED") // QUEUED | SENT | FAILED | SKIPPED
  scheduledAt DateTime?           @map("scheduled_at") @db.Timestamptz
  sentAt      DateTime?           @map("sent_at") @db.Timestamptz
  error       String?
  providerRef String?             @map("provider_ref")
  /// กันส่งซ้ำ เช่น "vaccine-due:<petId>:<dueDate>"
  dedupeKey   String?             @map("dedupe_key")

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, scheduledAt])
}

model ReminderRule {
  id              String                @id @default(uuid(7)) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  type            String // APPOINTMENT | VACCINE_DUE | GROOMING_DUE | MED_REFILL | STAY_CHECKOUT
  offsetDays      Int                   @map("offset_days") // ลบ = ก่อนถึงกำหนด
  sendAtLocalTime String                @default("09:00") @map("send_at_local_time")
  channels        NotificationChannel[]
  templateKey     String                @map("template_key")
  isActive        Boolean               @default(true) @map("is_active")

  @@unique([tenantId, type, offsetDays])
}
