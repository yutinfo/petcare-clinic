  priceSatang          Int             @map("price_satang")
  taxCode              TaxCode         @default(VAT7) @map("tax_code")
  durationMinutes      Int?            @map("duration_minutes") // ใช้จัดตารางนัด
  requiredResourceType ResourceType?   @map("required_resource_type")
  /// ให้ลูกค้าจองเองผ่านพอร์ทัลได้หรือไม่
  isBookableOnline     Boolean         @default(false) @map("is_bookable_online")
  onlineDepositSatang  Int             @default(0) @map("online_deposit_satang")
  speciesCodes         String[]        @map("species_codes") // จำกัดชนิดสัตว์ที่ใช้บริการนี้ได้
  isActive             Boolean         @default(true) @map("is_active")
  sortOrder            Int             @default(0) @map("sort_order")

