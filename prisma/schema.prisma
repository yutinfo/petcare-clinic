  priceSatang Int     @map("price_satang")
  validDays   Int?    @map("valid_days") // อายุแพ็กเกจหลังซื้อ
  isActive    Boolean @default(true) @map("is_active")

  lines ServicePackageLine[]

  @@unique([tenantId, code])
}

model ServicePackageLine {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  packageId     String         @map("package_id") @db.Uuid
  package       ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceItemId String?        @map("service_item_id") @db.Uuid
  serviceItem   ServiceItem?   @relation(fields: [serviceItemId], references: [id])
  productId     String?        @map("product_id") @db.Uuid
  product       Product?       @relation(fields: [productId], references: [id])
  qty           Decimal        @db.Decimal(10, 2)
}

enum ProductType {
  DRUG // ยา
  VACCINE
  CONSUMABLE // เวชภัณฑ์สิ้นเปลือง
  FOOD // อาหารสัตว์
  RETAIL // ของใช้ ปลอกคอ ของเล่น
  SUPPLEMENT
}

model Product {
  id                   String      @id @default(uuid(7)) @db.Uuid
  tenantId             String      @map("tenant_id") @db.Uuid
  code                 String
  barcode              String?
  name                 String
  genericName          String?     @map("generic_name")
  searchKey            String      @map("search_key")
  type                 ProductType
  category             String?
  dosageForm           String?     @map("dosage_form") // เม็ด, น้ำแขวนตะกอน, ครีม
  strength             String? // "250 mg"
  baseUnit             String      @map("base_unit") // หน่วยที่ใช้นับสต็อก: เม็ด, ml, ชิ้น
  isControlled         Boolean     @default(false) @map("is_controlled")
  controlledClass      String?     @map("controlled_class") // วัตถุออกฤทธิ์ประเภท 2/3/4, ยาเสพติดให้โทษประเภท 2
  requiresPrescription Boolean     @default(false) @map("requires_prescription")
  defaultPriceSatang   Int         @map("default_price_satang")
  costSatang           Int?        @map("cost_satang") // ต้นทุนเฉลี่ยล่าสุด (ใช้ทำกำไรขั้นต้น)
  taxCode              TaxCode     @default(VAT7) @map("tax_code")
  reorderPointBase     Decimal?    @map("reorder_point_base") @db.Decimal(14, 4)
  maxStockBase         Decimal?    @map("max_stock_base") @db.Decimal(14, 4)
  storageNote          String?     @map("storage_note") // เก็บในตู้เย็น 2-8°C
  manufacturer         String?
  isActive             Boolean     @default(true) @map("is_active")
  deletedAt            DateTime?   @map("deleted_at") @db.Timestamptz

  units         ProductUnit[]
  lots          StockLot[]
  movements     StockMovement[]
  onHand        StockOnHand[]
  prescriptions Prescription[]
  dispenses     Dispense[]
  chargeItems   ChargeItem[]
  vaccinations  Vaccination[]
  purchaseLines PurchaseOrderLine[]
  receiptLines  GoodsReceiptLine[]
  transferLines StockTransferLine[]
  countLines    StockCountLine[]
  packageLines  ServicePackageLine[]

  @@unique([tenantId, code])
  @@index([tenantId, barcode])
  @@index([tenantId, type, isActive])
}

/// หน่วยนับหลายชั้น: กล่อง(100) → แผง(10) → เม็ด(1)
model ProductUnit {
  id             String  @id @default(uuid(7)) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitName       String  @map("unit_name")
  factorToBase   Decimal @map("factor_to_base") @db.Decimal(14, 4)
  isPurchaseUnit Boolean @default(false) @map("is_purchase_unit")
  isSaleUnit     Boolean @default(true) @map("is_sale_unit")
  priceSatang    Int?    @map("price_satang") // ราคาขายเฉพาะหน่วยนี้ (ถ้า null ใช้ defaultPrice × factor)
  barcode        String?

  chargeItems ChargeItem[]

  @@unique([productId, unitName])
}

// ============================================================================
// INVENTORY — คลังสินค้า
// ============================================================================

model Supplier {
