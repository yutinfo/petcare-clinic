// ============================================================================
// BILLING — ค่าใช้จ่าย, บิล, การชำระเงิน, ภาษี
// ============================================================================

enum ChargeSourceType {
  ENCOUNTER
  STAY
  GROOMING
  POS
  BOOKING_DEPOSIT
  MANUAL
}

enum ChargeItemType {
  SERVICE
  PRODUCT
  PACKAGE
  DEPOSIT
  FEE // ค่าธรรมเนียม เช่น ค่ารับฝากนอกเวลา
  DISCOUNT_ADJUSTMENT
}

enum ChargeStatus {
  OPEN // ยังไม่วางบิล
  INVOICED
  VOID
}

/// จุดรวมค่าใช้จ่ายจากทุกโมดูล — ทำให้ออกบิลเดียวจบและรายงานไม่แตก
model ChargeItem {
  id                   String           @id @default(uuid(7)) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  branchId             String           @map("branch_id") @db.Uuid
  ownerId              String           @map("owner_id") @db.Uuid
  owner                Owner            @relation(fields: [ownerId], references: [id])
  petId                String?          @map("pet_id") @db.Uuid
  pet                  Pet?             @relation(fields: [petId], references: [id])
  sourceType           ChargeSourceType @map("source_type")
  encounterId          String?          @map("encounter_id") @db.Uuid
  encounter            Encounter?       @relation(fields: [encounterId], references: [id])
  stayId               String?          @map("stay_id") @db.Uuid
  stay                 Stay?            @relation(fields: [stayId], references: [id])
  groomingJobId        String?          @map("grooming_job_id") @db.Uuid
  groomingJob          GroomingJob?     @relation(fields: [groomingJobId], references: [id])
  posSaleId            String?          @map("pos_sale_id") @db.Uuid
  posSale              PosSale?         @relation(fields: [posSaleId], references: [id])
  bookingId            String?          @map("booking_id") @db.Uuid
  booking              Booking?         @relation(fields: [bookingId], references: [id])
  itemType             ChargeItemType   @map("item_type")
  serviceItemId        String?          @map("service_item_id") @db.Uuid
  serviceItem          ServiceItem?     @relation(fields: [serviceItemId], references: [id])
  productId            String?          @map("product_id") @db.Uuid
  product              Product?         @relation(fields: [productId], references: [id])
  productUnitId        String?          @map("product_unit_id") @db.Uuid
  productUnit          ProductUnit?     @relation(fields: [productUnitId], references: [id])
  description          String
  qty                  Decimal          @db.Decimal(12, 4)
  unitName             String?          @map("unit_name")
  unitPriceSatang      Int              @map("unit_price_satang")
  discountSatang       Int              @default(0) @map("discount_satang")
  discountReason       String?          @map("discount_reason")
  discountApprovedById String?          @map("discount_approved_by_id") @db.Uuid
  taxCode              TaxCode          @default(VAT7) @map("tax_code")
  vatRatePercent       Decimal          @default(7) @map("vat_rate_percent") @db.Decimal(5, 2)
  /// (qty × unitPrice) − discount — คำนวณและตรึงไว้ตอนสร้าง
  amountSatang         Int              @map("amount_satang")
  performedById        String?          @map("performed_by_id") @db.Uuid
  occurredAt           DateTime         @default(now()) @map("occurred_at") @db.Timestamptz
  status               ChargeStatus     @default(OPEN)
  invoiceId            String?          @map("invoice_id") @db.Uuid
  invoice              Invoice?         @relation(fields: [invoiceId], references: [id])
  createdById          String?          @map("created_by_id") @db.Uuid
  voidedAt             DateTime?        @map("voided_at") @db.Timestamptz
  voidedById           String?          @map("voided_by_id") @db.Uuid
  voidReason           String?          @map("void_reason")

  @@index([tenantId, ownerId, status])
  @@index([tenantId, branchId, occurredAt])
  @@index([tenantId, sourceType, encounterId])
}

model PosSale {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  number    String
  ownerId   String?   @map("owner_id") @db.Uuid // ขายลูกค้าทั่วไปได้ ไม่ต้องมีเจ้าของสัตว์
  owner     Owner?    @relation(fields: [ownerId], references: [id])
  status    String    @default("OPEN") // OPEN | INVOICED | VOID
  openedAt  DateTime  @default(now()) @map("opened_at") @db.Timestamptz
  closedAt  DateTime? @map("closed_at") @db.Timestamptz
  cashierId String    @map("cashier_id") @db.Uuid
  shiftId   String?   @map("shift_id") @db.Uuid
  note      String?

  chargeItems ChargeItem[]
  invoice     Invoice?

  @@unique([tenantId, number])
  @@index([tenantId, branchId, openedAt])
}

enum InvoiceDocType {
  FULL_TAX_INVOICE // ใบกำกับภาษีเต็มรูป (ม.86/4)
  ABBREVIATED_TAX_INVOICE // ใบกำกับภาษีอย่างย่อ (ม.86/6)
  RECEIPT // ใบเสร็จรับเงิน (กิจการไม่จด VAT)
  PROFORMA // ใบแจ้งหนี้ / ใบวางบิล
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

/// เมื่อ status พ้น DRAFT แล้ว ห้ามแก้ไขทุกฟิลด์ที่มีผลต่อยอดเงิน
model Invoice {
  id                  String         @id @default(uuid(7)) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  branchId            String         @map("branch_id") @db.Uuid
  docType             InvoiceDocType @map("doc_type")
  number              String // INV-BKK-2569-000123
  ownerId             String         @map("owner_id") @db.Uuid
  owner               Owner          @relation(fields: [ownerId], references: [id])
  posSaleId           String?        @unique @map("pos_sale_id") @db.Uuid
  posSale             PosSale?       @relation(fields: [posSaleId], references: [id])
  status              InvoiceStatus  @default(DRAFT)
  issuedAt            DateTime?      @map("issued_at") @db.Timestamptz
  dueAt               DateTime?      @map("due_at") @db.Date
  // --- ข้อมูลผู้ซื้อ ณ เวลาออกเอกสาร (snapshot) ---
  buyerName           String         @map("buyer_name")
  buyerTaxId          String?        @map("buyer_tax_id")
  buyerBranchCode     String?        @map("buyer_branch_code")
  buyerAddress        String?        @map("buyer_address")
  // --- ข้อมูลผู้ขาย ณ เวลาออกเอกสาร (snapshot) ---
  sellerName          String         @map("seller_name")
  sellerTaxId         String?        @map("seller_tax_id")
  sellerAddress       String?        @map("seller_address")
  sellerBranchCode    String         @default("00000") @map("seller_branch_code")
  // --- ยอดเงิน ---
  priceIncludesVat    Boolean        @default(false) @map("price_includes_vat")
  subtotalSatang      Int            @default(0) @map("subtotal_satang")
  discountSatang      Int            @default(0) @map("discount_satang")
  vatBaseSatang       Int            @default(0) @map("vat_base_satang")
  vatSatang           Int            @default(0) @map("vat_satang")
  exemptSatang        Int            @default(0) @map("exempt_satang")
  grandTotalSatang    Int            @default(0) @map("grand_total_satang")
  paidSatang          Int            @default(0) @map("paid_satang")
  balanceSatang       Int            @default(0) @map("balance_satang")
  note                String?
  issuedById          String?        @map("issued_by_id") @db.Uuid
  voidedAt            DateTime?      @map("voided_at") @db.Timestamptz
  voidedById          String?        @map("voided_by_id") @db.Uuid
  voidReason          String?        @map("void_reason")
  replacedByInvoiceId String?        @map("replaced_by_invoice_id") @db.Uuid
  replacedBy          Invoice?       @relation("InvoiceReplacement", fields: [replacedByInvoiceId], references: [id])
  replaces            Invoice[]      @relation("InvoiceReplacement")
  pdfKey              String?        @map("pdf_key")
  etaxStatus          String?        @map("etax_status") // PENDING | SUBMITTED | ACCEPTED | REJECTED
  etaxRef             String?        @map("etax_ref")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz

  lines       InvoiceLine[]
  payments    Payment[]
  creditNotes CreditNote[]
  chargeItems ChargeItem[]

  @@unique([tenantId, branchId, docType, number])
  @@index([tenantId, ownerId, issuedAt])
  @@index([tenantId, branchId, status, issuedAt])
}

/// สำเนาของ ChargeItem ณ เวลาออกบิล — ไม่อ้างราคาปัจจุบัน
model InvoiceLine {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  invoiceId       String         @map("invoice_id") @db.Uuid
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNo          Int            @map("line_no")
  chargeItemId    String?        @map("charge_item_id") @db.Uuid
  itemType        ChargeItemType @map("item_type")
  itemCode        String?        @map("item_code")
  description     String
  petName         String?        @map("pet_name")
  qty             Decimal        @db.Decimal(12, 4)
  unitName        String?        @map("unit_name")
  unitPriceSatang Int            @map("unit_price_satang")
  discountSatang  Int            @default(0) @map("discount_satang")
  taxCode         TaxCode        @map("tax_code")
  vatRatePercent  Decimal        @map("vat_rate_percent") @db.Decimal(5, 2)
  vatSatang       Int            @map("vat_satang")
  amountSatang    Int            @map("amount_satang")
  performedByName String?        @map("performed_by_name")
  creditNoteLines CreditNoteLine[]

  @@unique([invoiceId, lineNo])
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PROMPTPAY
  BANK_TRANSFER
  STORE_CREDIT // ใช้มัดจำ/เครดิตที่มีอยู่
  INSURANCE
  OTHER
}

model Payment {
  id           String        @id @default(uuid(7)) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  branchId     String        @map("branch_id") @db.Uuid
  invoiceId    String?       @map("invoice_id") @db.Uuid
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  ownerId      String        @map("owner_id") @db.Uuid
  method       PaymentMethod
  amountSatang Int           @map("amount_satang")
  receivedAt   DateTime      @default(now()) @map("received_at") @db.Timestamptz
  receivedById String        @map("received_by_id") @db.Uuid
  shiftId      String?       @map("shift_id") @db.Uuid
  shift        CashierShift? @relation(fields: [shiftId], references: [id])
  reference    String? // เลขอ้างอิงโอน / slip
  cardLast4    String?       @map("card_last4")
  gatewayRef   String?       @map("gateway_ref")
  status       String        @default("SUCCEEDED") // SUCCEEDED | VOIDED | REFUNDED
  voidedAt     DateTime?     @map("voided_at") @db.Timestamptz
  voidReason   String?       @map("void_reason")
  note         String?

  @@index([tenantId, branchId, receivedAt])
  @@index([tenantId, shiftId])
}

/// ใบลดหนี้ (ม.86/10) — ใช้แก้บิลที่ออกไปแล้ว ห้ามแก้ Invoice เดิม
model CreditNote {
  id                   String   @id @default(uuid(7)) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  branchId             String   @map("branch_id") @db.Uuid
  number               String
  invoiceId            String   @map("invoice_id") @db.Uuid
  invoice              Invoice  @relation(fields: [invoiceId], references: [id])
  reasonCode           String   @map("reason_code") // PRICE_ERROR | SERVICE_NOT_RENDERED | RETURN | DISCOUNT_AFTER
  reason               String
  originalAmountSatang Int      @map("original_amount_satang")
  correctAmountSatang  Int      @map("correct_amount_satang")
  differenceSatang     Int      @map("difference_satang")
  vatSatang            Int      @map("vat_satang")
  issuedAt             DateTime @default(now()) @map("issued_at") @db.Timestamptz
  issuedById           String   @map("issued_by_id") @db.Uuid
  pdfKey               String?  @map("pdf_key")
  lines                CreditNoteLine[]

  @@unique([tenantId, branchId, number])
}

/// บรรทัดใบลดหนี้ — ใช้ตอนคืนสินค้าหรือลดเฉพาะรายการ หัวเอกสารยังเก็บยอดรวม
model CreditNoteLine {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  creditNoteId  String       @map("credit_note_id") @db.Uuid
  creditNote    CreditNote   @relation(fields: [creditNoteId], references: [id])
  invoiceLineId String?      @map("invoice_line_id") @db.Uuid
  invoiceLine   InvoiceLine? @relation(fields: [invoiceLineId], references: [id])
  description   String
  qty           Decimal      @db.Decimal(12, 4)
  amountSatang  Int          @map("amount_satang")
  vatSatang     Int          @map("vat_satang")
  productId     String?      @map("product_id") @db.Uuid

  @@index([tenantId, creditNoteId])
}

/// คำแปลแค็ตตาล็อกตาม locale — นำเข้าภาษาเพิ่มได้โดยไม่เพิ่มคอลัมน์
model CatalogTranslation {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  entityType String @map("entity_type")
  entityId   String @map("entity_id") @db.Uuid
  field      String
  locale     String
  text       String

  @@unique([tenantId, entityType, entityId, field, locale])
  @@index([tenantId, entityType, locale])
}

enum DepositStatus {
  AVAILABLE
  PARTIALLY_USED
  USED
  REFUNDED
  EXPIRED
}

/// มัดจำค่าจองห้องฝาก / เครดิตคงเหลือของลูกค้า
model Deposit {
  id              String        @id @default(uuid(7)) @db.Uuid
