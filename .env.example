# ---- Database ----
# แอปเชื่อมด้วย role ที่ไม่ใช่เจ้าของตาราง เพื่อให้ RLS มีผลจริง
# ค่าด้านล่างตรงกับ docker-compose.yml สำหรับเครื่องพัฒนา
DATABASE_URL="postgresql://app_user:app_user_dev@localhost:5432/petcare?schema=public"
# role แยกสำหรับ prisma migrate เท่านั้น
MIGRATE_DATABASE_URL="postgresql://app_migrator:app_migrator_dev@localhost:5432/petcare?schema=public"

# ---- Auth ----
AUTH_SECRET="dev-only-change-me-use-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ---- Redis (cache, queue, distributed lock) ----
REDIS_URL="redis://localhost:6379"

# ---- Object storage (S3-compatible) ----
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-southeast-1"
S3_BUCKET="petcare-files"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- การเข้ารหัสข้อมูลอ่อนไหวที่ชั้นแอป (เลขบัตรประชาชน, MFA secret) ----
FIELD_ENCRYPTION_KEY=""

# ---- Notification providers ----
SMS_PROVIDER_API_KEY=""
SMTP_URL=""
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""

# ---- Payment ----
PROMPTPAY_MERCHANT_ID=""
PAYMENT_GATEWAY_SECRET=""

# ---- Platform ----
APP_BASE_DOMAIN="petcare.app"
DEFAULT_TIMEZONE="Asia/Bangkok"
